<Window x:Class="WpfTutorialSamples.ListView_control.ListViewColumnSortingSample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AttacheCaseLIst" Height="800" Width="800">
    
    <Grid Margin="10">
        <StackPanel Margin="10,10,10,10" Grid.ColumnSpan="2">
            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_ChangedEventHandler" Width="399"/>
        </StackPanel>
        <ListView Name="attaItems" HorizontalAlignment="Left" Width="750" Margin="0,41,0,0">
            <ListView.Style>
                <Style TargetType="ListView">
                    <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                </Style>
            </ListView.Style>

            <ListView.View>
                <GridView>
                    <GridViewColumn Width="550" DisplayMemberBinding="{Binding name}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="name" Click="attaItemsColumnHeader_Click">名前</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding lastWriteTime}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="lastWriteTime" Click="attaItemsColumnHeader_Click">更新日時</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Name="itemCount" Content="Label" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
