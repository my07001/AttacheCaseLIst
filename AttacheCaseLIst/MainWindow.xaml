<Window x:Class="AttacheCaseLIst.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AttacheCaseLIst"
        mc:Ignorable="d"
        Title="AttacheCaseLIst" Height="850" Width="800" Icon="/icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="10,10,10,10" Grid.ColumnSpan="2">
            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_ChangedEventHandler" Width="399"/>
        </StackPanel>
        <ListBox x:Name="FileListBox" Margin="0,41,0,0"
                    AllowDrop="True"
                    Drop="FileListBox_Drop"
                    DragOver="FileListBox_DragOver" Grid.ColumnSpan="2">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <EventSetter Event="MouseDoubleClick" Handler="FileListBox_MouseDoubleClick"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--<Setter Property="Fill" Value="GreenYellow"/>-->
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <!--<Setter Property="Fill" Value="RosyBrown"/>-->
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
        </ListBox>
    </Grid>

</Window>
